# Copy to .env locally — never commit real values.
#
# Nace console registers with an email OTP obtained through a real inbox.
# Cloudflare temp-mail drops nace.ai OTP, so use a Hotmail/Outlook pool.

# Mailbox source (hotmail is required for the OTP to arrive)
NACE_EMAIL_SOURCE=hotmail

# Referral invite (the "类目" invite link); default is baked into protocol.
# NACE_INVITE_URL=https://console.nace.ai/invite/adf5acm5

# OTP poll window (seconds)
NACE_OTP_TIMEOUT=240

# Optional: pin the Chromium build that clears Turnstile (Chrome 149 /
# ms-playwright chromium-1228). Auto-discovered when unset.
# NACE_CHROME_PATH=/path/to/chrome

# Fixed register egress (browser proxy). Empty = direct.
# NACE_PROXY=http://127.0.0.1:7897

# Set 1 only for an attended debug run (leaves the browser open at the end).
# NACE_KEEP_BROWSER=0